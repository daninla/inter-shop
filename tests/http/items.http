@host = http://localhost:5000/api

### Create item (type_id matches the Items model; title belongs to its model)
POST {{host}}/items/create
Content-Type: application/json

{
  "brand_id": 1,
  "model_id": 1,
  "type_id": 1,
  "categ_id": 1,
  "store_id": 1,
  "price": 999.99,
  "amount": 5
}

### Get limited items
GET {{host}}/items/limited

### Get items with id > middle
GET {{host}}/items/middle

### Get items by multiple brand ids
GET {{host}}/items/multiple?ids=10,11,12

### Delete items by array of brand ids
DELETE {{host}}/items/multiple
Content-Type: application/json

{
  "values": [10, 11]
}

### Update item
PATCH {{host}}/items/update
Content-Type: application/json

{
  "item_id": 1,
  "price": 1099.99,
  "amount": 15
}
