@host = http://localhost:5000/api

### Get limited customers
GET {{host}}/customers/limited

### Get customers with id > middle
GET {{host}}/customers/middle

### Get customers by multiple ids
GET {{host}}/customers/multiple?ids=10,11,12

### Delete customers by array of emails
DELETE {{host}}/customers/multiple
Content-Type: application/json

{
  "values": ["sergey@example.com", "elena@example.com"]
}

### Update customer
PATCH {{host}}/customers/update
Content-Type: application/json

{
  "id": 1,
  "name": "Ivan Petrov",
  "email": "ivan.petrov@example.com"
}
