@host = http://localhost:5000/api

### Create customer (password is required and is not returned in the response)
POST {{host}}/customers/create
Content-Type: application/json

{
  "name": "Test Customer",
  "email": "test.customer@example.com",
  "password": "Password123"
}

### Get limited customers
GET {{host}}/customers/limited

### Get customers with id > middle
GET {{host}}/customers/middle

### Get customers by multiple ids
GET {{host}}/customers/multiple?ids=10,11,12

### Delete customers by array of emails
DELETE {{host}}/customers/multiple
Content-Type: application/json

{
  "values": ["sergey@example.com", "elena@example.com"]
}

### Update customer
PATCH {{host}}/customers/update
Content-Type: application/json

{
  "id": 1,
  "name": "Ivan Petrov",
  "email": "ivan.petrov@example.com"
}

### Customer with most purchases
GET {{host}}/customers/top-orders

### Customer who bought the most expensive item
GET {{host}}/customers/top-expensive-item
