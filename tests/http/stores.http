@host = http://localhost:5000/api

### Get limited stores
GET {{host}}/stores/limited

### Get stores with id > middle
GET {{host}}/stores/middle

### Get stores by multiple ids
GET {{host}}/stores/multiple?ids=10,11,12

### Delete stores by array of ids
DELETE {{host}}/stores/multiple
Content-Type: application/json

{
  "values": [10, 11]
}

### Update store
PATCH {{host}}/stores/update
Content-Type: application/json

{
  "id": 1,
  "title": "Центральный магазин обновлён",
  "description": "Обновлённое описание"
}
