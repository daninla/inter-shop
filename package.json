{
  "name": "inter-shop",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "sequelize-cli db:migrate --config ./database/config/configDB.js --migrations-path ./database/migrations --models-path ./database/models --seeders-path ./database/seeders",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config ./database/config/configDB.js --migrations-path ./database/migrations --models-path ./database/models --seeders-path ./database/seeders",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config ./database/config/configDB.js --migrations-path ./database/migrations --models-path ./database/models --seeders-path ./database/seeders",
    "db:seed": "sequelize-cli db:seed:all --config ./database/config/configDB.js --migrations-path ./database/migrations --models-path ./database/models --seeders-path ./database/seeders",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config ./database/config/configDB.js --migrations-path ./database/migrations --models-path ./database/models --seeders-path ./database/seeders"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.5",
    "yup": "^1.7.1"
  }
}
